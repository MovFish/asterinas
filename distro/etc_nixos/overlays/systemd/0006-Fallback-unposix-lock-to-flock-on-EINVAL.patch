From 24891b2c4e6a8d0f1e2c3b4a5d6e7f8a9b0c1d2e Mon Sep 17 00:00:00 2001
From: Asterinas Contributors <dev@asterinas.org>
Date: Fri, 2 Oct 2026 16:45:00 +0000
Subject: [PATCH] Fallback unposix lock to flock on EINVAL

Asterinas returns EINVAL for fcntl open-file-description lock operations.
Use flock only on that error, retaining all other failures. These callers
lock whole files; flock likewise associates the lock with the open file
description and releases it when the last reference closes. Apply the
same fallback on unlock so udev can serialize devlink updates.

---
 src/basic/lock-util.c | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

--- a/src/basic/lock-util.c
+++ b/src/basic/lock-util.c
@@ -158,7 +158,13 @@
 }
 
 int unposix_lock(int fd, int operation) {
-        return fcntl_lock(fd, operation, /* ofd= */ true);
+        int r;
+
+        r = fcntl_lock(fd, operation, /* ofd= */ true);
+        if (r == -EINVAL)
+                return RET_NERRNO(flock(fd, operation));
+
+        return r;
 }
 
 void posix_unlockpp(int **fd) {
@@ -177,7 +183,8 @@
         if (!*fd || **fd < 0)
                 return;
 
-        (void) fcntl_lock(**fd, LOCK_UN, /* ofd= */ true);
+        if (fcntl_lock(**fd, LOCK_UN, /* ofd= */ true) == -EINVAL)
+                (void) flock(**fd, LOCK_UN);
         *fd = NULL;
 }
 
