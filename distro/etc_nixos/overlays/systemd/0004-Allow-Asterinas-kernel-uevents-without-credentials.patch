From 6c5c638d9510ea937c2e466c92fdbfcf2720f20b Mon Sep 17 00:00:00 2001
From: Asterinas Developers <asterinas@lists.asterinas.dev>
Date: Mon, 29 Sep 2026 16:30:00 +0800
Subject: [PATCH] Allow Asterinas kernel uevents without credentials

Asterinas does not yet attach SCM_CREDENTIALS ancillary data to
kernel-origin NETLINK_KOBJECT_UEVENT datagrams, even when SO_PASSCRED is
set. Keep the normal sender credential validation for every message that
has credentials and for all other monitor contexts. Only accept a missing
credential record when both the receiving monitor and source address are
the kernel kobject-uevent multicast group and the source port is zero.

This is a compatibility reduction, not equivalent to Linux SO_PASSCRED
semantics: source address checks do not authenticate ancillary sender data.
---
 src/libsystemd/sd-device/device-monitor.c | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/src/libsystemd/sd-device/device-monitor.c b/src/libsystemd/sd-device/device-monitor.c
index a5af64662..a5b8cf65d 100644
--- a/src/libsystemd/sd-device/device-monitor.c
+++ b/src/libsystemd/sd-device/device-monitor.c
@@ -624,11 +624,20 @@ static int device_monitor_receive_device(sd_device_monitor *m, sd_device **ret)
         }
 
         cred = CMSG_FIND_DATA(&smsg, SOL_SOCKET, SCM_CREDENTIALS, struct ucred);
-        if (!cred)
+        if (!cred &&
+            !(m->snl.nl.nl_groups == MONITOR_GROUP_KERNEL &&
+              snl.nl.nl_groups == MONITOR_GROUP_KERNEL &&
+              snl.nl.nl_pid == 0))
                 return log_monitor_errno(m, SYNTHETIC_ERRNO(EAGAIN),
                                          "No sender credentials received, ignoring message.");
 
-        if (!check_sender_uid(m, cred->uid))
+        if (!cred)
+                /* Asterinas currently omits SCM_CREDENTIALS from kernel-origin kobject uevents.
+                 * Keep this exception constrained to the kernel monitor, kernel multicast group,
+                 * and source port zero. Do not extend it to unicast or udev-origin messages. */
+                log_monitor(m, "Accepting Asterinas kernel uevent without sender credentials.");
+
+        if (cred && !check_sender_uid(m, cred->uid))
                 return log_monitor_errno(m, SYNTHETIC_ERRNO(EAGAIN),
                                          "Sender uid="UID_FMT", message ignored.", cred->uid);
 
-- 
